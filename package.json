{
  "name": "agent-office",
  "private": true,
  "version": "1.0.0",
  "description": "A private, mobile-first AI team on Cloudflare with visible orchestration and an optional guarded local runner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Showndarya/agent-office.git"
  },
  "homepage": "https://github.com/Showndarya/agent-office#readme",
  "bugs": {
    "url": "https://github.com/Showndarya/agent-office/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "CLOUDFLARE_VITE_FORCE_LOCAL=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply agent-office-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply agent-office-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.145.0"
  }
}
