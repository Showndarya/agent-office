AGENT_OFFICE_URL=https://your-worker.your-subdomain.workers.dev
AGENT_OFFICE_RUNNER_TOKEN=replace-me
CF_ACCESS_CLIENT_ID=replace-me.access
CF_ACCESS_CLIENT_SECRET=replace-me

AGENT_OFFICE_RUNNER_ID=personal-computer
AGENT_OFFICE_RUNNER_NAME="Personal computer"
AGENT_OFFICE_WORKSPACE=/absolute/path/to/agent-office
AGENT_OFFICE_PROVIDER=codex
AGENT_OFFICE_POLL_SECONDS=12
AGENT_OFFICE_TASK_TIMEOUT=3600
AGENT_OFFICE_DEPLOY_TIMEOUT=1200
AGENT_OFFICE_WORKSHOP_ROOT=/absolute/path/to/agent-office-worktrees
AGENT_OFFICE_LUKE_MODEL=gpt-6-luna
CODEX_BIN=codex

# Optional: run Codex with Ollama instead of the signed-in Codex provider.
# AGENT_OFFICE_PROVIDER=ollama
# AGENT_OFFICE_LOCAL_MODEL=your-installed-model
